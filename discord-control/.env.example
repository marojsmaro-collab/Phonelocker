# Copy this file to .env and fill it in. Never commit .env or share it.

# Your bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Password for the website so nobody else can control your bot (6+ characters)
DASHBOARD_PASSWORD=

# Pick ONE AI key. The first one that is set gets used (or force one with AI_PROVIDER).
# Free: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Free: https://console.groq.com/keys
GROQ_API_KEY=
# Paid, best quality: https://platform.claude.com
ANTHROPIC_API_KEY=

# Optional overrides
# AI_PROVIDER=gemini        # gemini | groq | anthropic
# GEMINI_MODEL=gemini-flash-latest
# GROQ_MODEL=openai/gpt-oss-120b
# ANTHROPIC_MODEL=claude-opus-5-5
# PORT=3000

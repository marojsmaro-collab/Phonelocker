# Copy this file to .env and fill it in. Never commit .env or share it.

# Your bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Password for the website so nobody else can control your bot (6+ characters)
DASHBOARD_PASSWORD=

# AI keys. Add as many as you have: the bot uses the best one and falls back to the next
# if one hits its free limit.
# Strongest free brain: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Free and very fast backup: https://console.groq.com/keys
GROQ_API_KEY=
# Paid, optional: https://platform.claude.com
ANTHROPIC_API_KEY=

# Optional
# POLLINATIONS_KEY=        # free key from https://enter.pollinations.ai for faster AI images
# AI_PROVIDER=gemini       # force which AI goes first: gemini | groq | anthropic
# GEMINI_MODEL=gemini-flash-latest
# GROQ_MODEL=openai/gpt-oss-120b
# AI_AUTOFIX=off           # turn off the AI fixing its own failed steps
# PORT=3000
